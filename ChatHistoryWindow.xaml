<Window x:Class="AiSecretary.Desktop.ChatHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 秘書 — 對話紀錄"
        Width="520"
        Height="680"
        MinWidth="400"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Padding="16,12" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="HeaderTitle"
                               Text="AI 秘書對話紀錄"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSubtitle"
                               Text="即時同步桌面寵物對話"
                               FontSize="11.5"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="ScrollBottomBtn"
                        DockPanel.Dock="Right"
                        Content="捲至最新"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Click="ScrollBottomBtn_Click" />
            </DockPanel>
        </Border>

        <!-- Chat Messages -->
        <ScrollViewer x:Name="ChatScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14,12">
            <StackPanel x:Name="MessagesPanel" />
        </ScrollViewer>

        <!-- Input Bar -->
        <Border x:Name="InputBorder" Grid.Row="2" Padding="12,10" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="InputBoxFrame"
                        Grid.Column="0"
                        CornerRadius="16"
                        BorderThickness="1"
                        Padding="12,6"
                        Margin="0,0,8,0">
                    <TextBox x:Name="ChatInputBox"
                             Background="Transparent"
                             BorderThickness="0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="96"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="13"
                             PreviewKeyDown="ChatInputBox_PreviewKeyDown" />
                </Border>

                <Button x:Name="SendStopBtn"
                        Grid.Column="1"
                        Content="傳送"
                        MinWidth="68"
                        Height="34"
                        Padding="12,4"
                        FontWeight="SemiBold"
                        VerticalAlignment="Bottom"
                        Click="SendStopBtn_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
