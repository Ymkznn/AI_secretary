<ui:FluentWindow x:Class="AiSecretary.Desktop.AgentMonitorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AI 秘書 — Agent 運作詳情"
                 Width="640"
                 Height="500"
                 MinWidth="520"
                 MinHeight="380"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Microsoft JhengHei UI, Segoe UI"
                 FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AI 秘書 — Agent 運作詳情" ShowMaximize="True" ShowMinimize="True" />

        <Grid Grid.Row="1" Margin="18,6,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <TextBlock x:Name="HeaderText"
                           Text="Agent 執行連線圖（MainAgent → Planner → Worker）"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <ui:Button x:Name="StopAllBtn"
                           DockPanel.Dock="Right"
                           Content="全部強制終止"
                           Appearance="Danger"
                           Click="StopAllBtn_Click" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RunsPanel" Margin="0,0,6,0" />
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
