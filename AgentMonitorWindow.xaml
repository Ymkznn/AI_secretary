<ui:FluentWindow x:Class="AiSecretary.Desktop.AgentMonitorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AI 秘書 — Agent 運作詳情"
                 Width="720"
                 Height="600"
                 MinWidth="560"
                 MinHeight="420"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Microsoft JhengHei UI, Segoe UI"
                 FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AI 秘書 — Agent 運作詳情" ShowMaximize="True" ShowMinimize="True" />

        <Grid Grid.Row="1" Margin="18,6,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <TextBlock x:Name="HeaderText"
                           Text="運作總覽與背景排程（各區塊可點擊折疊）"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="ExpandAllBtn"
                               Content="全部展開"
                               Appearance="Secondary"
                               Padding="10,5"
                               FontSize="12"
                               Margin="0,0,6,0"
                               Click="ExpandAllBtn_Click" />
                    <ui:Button x:Name="CollapseAllBtn"
                               Content="全部折疊"
                               Appearance="Secondary"
                               Padding="10,5"
                               FontSize="12"
                               Margin="0,0,8,0"
                               Click="CollapseAllBtn_Click" />
                    <ui:Button x:Name="StopAllBtn"
                               Content="全部強制終止"
                               Appearance="Danger"
                               Click="StopAllBtn_Click" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RunsPanel" Margin="0,0,6,0" />
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
