<Window x:Class="AiSecretary.Desktop.AgentMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 秘書 — Agent 運作詳情"
        Width="600"
        Height="440"
        WindowStartupLocation="CenterScreen"
        FontSize="12.5">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock x:Name="HeaderText"
                       Text="Agent 執行連線圖（MainAgent → Planner → Worker）"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button x:Name="StopAllBtn"
                    DockPanel.Dock="Right"
                    Content="全部強制終止"
                    Padding="10,4"
                    Click="StopAllBtn_Click" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RunsPanel" />
        </ScrollViewer>
    </Grid>
</Window>
