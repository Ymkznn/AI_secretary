<Window x:Class="AiSecretary.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 秘書"
        Width="1400"
        Height="860"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <DropShadowEffect x:Key="GlassShadow" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#0F172A" />
        <DropShadowEffect x:Key="PetGlow" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.22" Color="#3B82F6" />

        <Storyboard x:Key="FloatAnimation" Timeline.DesiredFrameRate="24" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PetTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-5" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Modern Slim ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd"
                                                        Background="#5594A3B8"
                                                        CornerRadius="3"
                                                        Margin="1,2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#AA94A3B8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="108" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Speech-Bubble Output Box (Col 0 = top-left of pet, Col 2 = top-right of pet) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="OutputContainer"
                        Grid.Column="0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="0,0,6,4"
                        Visibility="Collapsed"
                        MouseEnter="HoverTarget_MouseEnter"
                        MouseLeave="HoverTarget_MouseLeave">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="BubbleTranslate" Y="0" />
                </StackPanel.RenderTransform>
                <Grid x:Name="PinnedRemindersContainer"
                      HorizontalAlignment="Right"
                      Margin="0,0,0,6"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="PinnedExpandedHost"
                          Grid.Row="0"
                          Width="280"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,4"
                          Visibility="Collapsed"
                          RenderTransformOrigin="1,1">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PinnedPanelScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <ScrollViewer x:Name="PinnedScroll"
                                      MaxHeight="260"
                                      VerticalAlignment="Bottom"
                                      CanContentScroll="False"
                                      PanningMode="VerticalOnly"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PinnedRemindersPanel"
                                        VerticalAlignment="Bottom" />
                        </ScrollViewer>
                        <!-- Independent Resize Thumbs for Pinned Card Panel -->
                        <Thumb x:Name="PinnedTopResizeThumb"
                               Height="6"
                               VerticalAlignment="Top"
                               Cursor="SizeNS"
                               Opacity="0"
                               DragDelta="PinnedTopResizeThumb_DragDelta" />
                        <Thumb x:Name="PinnedLeftResizeThumb"
                               Width="6"
                               HorizontalAlignment="Left"
                               Cursor="SizeWE"
                               Opacity="0"
                               DragDelta="PinnedLeftResizeThumb_DragDelta" />
                        <Thumb x:Name="PinnedRightResizeThumb"
                               Width="6"
                               HorizontalAlignment="Right"
                               Cursor="SizeWE"
                               Opacity="0"
                               DragDelta="PinnedRightResizeThumb_DragDelta" />
                        <Thumb x:Name="PinnedTopLeftResizeThumb"
                               Width="12" Height="12"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Cursor="SizeNWSE"
                               Opacity="0"
                               DragDelta="PinnedTopLeftResizeThumb_DragDelta" />
                        <Thumb x:Name="PinnedTopRightResizeThumb"
                               Width="12" Height="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Cursor="SizeNESW"
                               Opacity="0"
                               DragDelta="PinnedTopRightResizeThumb_DragDelta" />
                    </Grid>

                    <StackPanel x:Name="PinnedPillsBar"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="PinnedPillScale" ScaleX="1" ScaleY="1" />
                        </StackPanel.RenderTransform>
                        <Button x:Name="PinnedNotifPill"
                                Visibility="Collapsed"
                                Margin="0,0,6,0"
                                Padding="10,5"
                                Cursor="Hand"
                                ToolTip="一般通知與郵件提醒"
                                Click="PinnedNotifPill_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="14"
                                            BorderThickness="1"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            Effect="{StaticResource GlassShadow}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="PinnedNotifPillText" Text="📌 1" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                        <Button x:Name="PinnedSchedulePill"
                                Visibility="Collapsed"
                                Margin="0,0,6,0"
                                Padding="10,5"
                                Cursor="Hand"
                                ToolTip="週期規劃與行程提醒"
                                Click="PinnedSchedulePill_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="14"
                                            BorderThickness="1"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            Effect="{StaticResource GlassShadow}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="PinnedSchedulePillText" Text="📅 1" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                        <Button x:Name="PinnedConfirmPill"
                                Visibility="Collapsed"
                                Padding="10,5"
                                Cursor="Hand"
                                ToolTip="待確認任務"
                                Click="PinnedConfirmPill_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="14"
                                            BorderThickness="1"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            Effect="{StaticResource GlassShadow}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="PinnedConfirmPillText" Text="❓ 1" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Border x:Name="OutputBorder"
                        Width="245"
                        HorizontalAlignment="Right"
                        CornerRadius="16"
                        BorderBrush="#AAFFFFFF"
                        BorderThickness="1"
                        MaxHeight="420"
                        RenderTransformOrigin="0.5,0"
                        Effect="{StaticResource GlassShadow}">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BubbleScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="BubbleShrinkTranslate" Y="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#CCFFFFFF" Offset="0" />
                            <GradientStop Color="#B3F1F5F9" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <ScrollViewer x:Name="OutputScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="12,10,28,10"
                                      MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                            <StackPanel>
                                <TextBlock x:Name="OutputStatusText"
                                           Visibility="Collapsed"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="#2563EB"
                                           Margin="0,0,0,4" />
                                <RichTextBox x:Name="OutputRichText"
                                             IsReadOnly="True"
                                             IsDocumentEnabled="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             FontSize="13.5"
                                             Foreground="#0F172A" />
                                <WrapPanel x:Name="OutputActionsPanel" Margin="0,8,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Resize Thumbs -->
                        <Thumb x:Name="TopResizeThumb"
                               Height="6"
                               VerticalAlignment="Top"
                               Cursor="SizeNS"
                               Opacity="0"
                               DragDelta="TopResizeThumb_DragDelta" />
                        <Thumb x:Name="LeftResizeThumb"
                               Width="6"
                               HorizontalAlignment="Left"
                               Cursor="SizeWE"
                               Opacity="0"
                               DragDelta="LeftResizeThumb_DragDelta" />
                        <Thumb x:Name="RightResizeThumb"
                               Width="6"
                               HorizontalAlignment="Right"
                               Cursor="SizeWE"
                               Opacity="0"
                               DragDelta="RightResizeThumb_DragDelta" />
                        <Thumb x:Name="TopLeftResizeThumb"
                               Width="12" Height="12"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Cursor="SizeNWSE"
                               Opacity="0"
                               DragDelta="TopLeftResizeThumb_DragDelta" />
                        <Thumb x:Name="TopRightResizeThumb"
                               Width="12" Height="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Cursor="SizeNESW"
                               Opacity="0"
                               DragDelta="TopRightResizeThumb_DragDelta" />

                        <Button x:Name="CloseBubbleBtn"
                                Panel.ZIndex="30"
                                Width="22" Height="22"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,6,6,0"
                                Foreground="#334155"
                                Background="#2264748B"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="關閉氣泡"
                                Click="CloseBubbleBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBg"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="11">
                                        <TextBlock Text="✕"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBg" Property="Background" Value="#4464748B" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Polygon x:Name="BubbleTail"
                         Points="0,0 14,0 22,10"
                         Fill="#CCF1F5F9"
                         Stroke="#AAFFFFFF"
                         StrokeThickness="1"
                         HorizontalAlignment="Right"
                         Margin="0,-1,14,0" />
            </StackPanel>
        </Grid>

        <!-- Row 1: Fixed-Position Desktop Pet Mascot -->
        <Grid x:Name="PetAvatar"
              Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="100" Height="100"
              Cursor="Hand"
              Background="Transparent"
              MouseEnter="HoverTarget_MouseEnter"
              MouseLeave="HoverTarget_MouseLeave"
              MouseLeftButtonDown="Pet_MouseLeftButtonDown"
              MouseMove="Pet_MouseMove"
              MouseLeftButtonUp="Pet_MouseLeftButtonUp">

            <Grid.RenderTransform>
                <TranslateTransform x:Name="PetTransform" Y="0" />
            </Grid.RenderTransform>

            <Grid.ContextMenu>
                <ContextMenu x:Name="PetContextMenu" Opened="PetContextMenu_Opened">
                    <MenuItem Header="對話紀錄" Click="MenuChatHistory_Click" />
                    <MenuItem x:Name="MenuVoiceRoot" Header="語音切換">
                        <MenuItem x:Name="MenuTtsEnabled" Header="啟用語音播報" IsCheckable="True" Click="MenuTtsEnabled_Click" />
                        <Separator x:Name="MenuVoiceProfilesStartSeparator" />
                        <Separator x:Name="MenuVoiceProfilesEndSeparator" />
                        <MenuItem x:Name="MenuTtsModeSmart" Header="模式：智慧（短全唸／長摘要）" Tag="smart" IsCheckable="True" Click="MenuTtsMode_Click" />
                        <MenuItem x:Name="MenuTtsModeSummary" Header="模式：一律摘要" Tag="summary" IsCheckable="True" Click="MenuTtsMode_Click" />
                        <MenuItem x:Name="MenuTtsModeFull" Header="模式：全部唸出" Tag="full" IsCheckable="True" Click="MenuTtsMode_Click" />
                        <MenuItem x:Name="MenuTtsModeNotify" Header="模式：僅通知發聲" Tag="notify_only" IsCheckable="True" Click="MenuTtsMode_Click" />
                        <Separator />
                        <MenuItem Header="匯入語音包 (.zip)..." Click="MenuImportVoiceZip_Click" />
                        <MenuItem Header="立即試聽一句" Click="MenuTtsTest_Click" />
                    </MenuItem>
                    <MenuItem x:Name="MenuStyleRoot" Header="語氣切換" />
                    <MenuItem Header="資訊" Click="MenuInfo_Click" />
                    <MenuItem Header="詳細顯示" Click="MenuDetails_Click" />
                    <MenuItem Header="開啟專用瀏覽器（登入帳號）" Click="MenuOpenDedicatedBrowser_Click" />
                    <MenuItem Header="設定" Click="MenuSettings_Click" />
                    <MenuItem Header="最小化" Click="MenuMinimize_Click" />
                    <MenuItem Header="結束" Click="MenuExit_Click" />
                </ContextMenu>
            </Grid.ContextMenu>

            <Image x:Name="CustomPetImage"
                   Visibility="Collapsed"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Canvas x:Name="VectorMascot" Width="100" Height="100" Effect="{StaticResource PetGlow}">
                <Ellipse Canvas.Left="22" Canvas.Top="5" Width="56" Height="13"
                         Stroke="#60A5FA" StrokeThickness="2.2" Fill="#223B82F6" />

                <Polygon Points="20,40 14,13 38,26" Fill="#3B82F6" Stroke="#1D4ED8" StrokeThickness="1.5" />
                <Polygon Points="21,35 17,19 32,27" Fill="#BFDBFE" />
                <Polygon Points="80,40 86,13 62,26" Fill="#3B82F6" Stroke="#1D4ED8" StrokeThickness="1.5" />
                <Polygon Points="79,35 83,19 68,27" Fill="#BFDBFE" />

                <Ellipse Canvas.Left="12" Canvas.Top="22" Width="76" Height="66"
                         Stroke="#1D4ED8" StrokeThickness="2">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#EFF6FF" Offset="0" />
                            <GradientStop Color="#DBEAFE" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse x:Name="LeftEye" Canvas.Left="28" Canvas.Top="45" Width="11" Height="14" Fill="#1E293B" />
                <Ellipse Canvas.Left="31" Canvas.Top="47" Width="4" Height="4" Fill="#FFFFFF" />
                <Ellipse x:Name="RightEye" Canvas.Left="61" Canvas.Top="45" Width="11" Height="14" Fill="#1E293B" />
                <Ellipse Canvas.Left="64" Canvas.Top="47" Width="4" Height="4" Fill="#FFFFFF" />

                <Ellipse Canvas.Left="20" Canvas.Top="59" Width="10" Height="6" Fill="#FDA4AF" Opacity="0.7" />
                <Ellipse Canvas.Left="70" Canvas.Top="59" Width="10" Height="6" Fill="#FDA4AF" Opacity="0.7" />

                <Path Data="M 43,64 Q 50,70 57,64"
                      Stroke="#1E293B"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Fill="Transparent" />

                <Ellipse Canvas.Left="22" Canvas.Top="79" Width="16" Height="11" Fill="#FFFFFF" Stroke="#1D4ED8" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="62" Canvas.Top="79" Width="16" Height="11" Fill="#FFFFFF" Stroke="#1D4ED8" StrokeThickness="1.5" />
            </Canvas>
        </Grid>

        <!-- Row 2: Semi-Transparent Input Dialog Box (below the mascot) -->
        <Border x:Name="InputBorder"
                Grid.Row="2"
                Width="350"
                HorizontalAlignment="Center"
                Margin="0,6,0,0"
                Background="#B8FFFFFF"
                BorderBrush="#AAFFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="6,5,6,5"
                Effect="{StaticResource GlassShadow}">
            <StackPanel>
                <WrapPanel x:Name="AttachmentPanel" Margin="6,0,6,4" Visibility="Collapsed" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="AttachBtn"
                            Grid.Column="0"
                            Content="+"
                            Width="28" Height="28"
                            VerticalAlignment="Bottom"
                            Margin="0,0,6,0"
                            FontSize="16" FontWeight="SemiBold"
                            Foreground="#475569"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="添加附件"
                            Click="AttachBtn_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="14" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="InputPlaceholder"
                                   Text="輸入指令..."
                                   FontSize="12.5"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="InputBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13.5"
                                 Foreground="#0F172A"
                                 MinHeight="28"
                                 MaxHeight="82"
                                 Padding="0,3"
                                 VerticalContentAlignment="Center"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 TextChanged="InputBox_TextChanged"
                                 PreviewKeyDown="InputBox_PreviewKeyDown" />
                    </Grid>

                    <Button x:Name="SendBtn"
                            Grid.Column="2"
                            Content="↑"
                            Width="30" Height="30"
                            VerticalAlignment="Bottom"
                            Margin="4,0,0,0"
                            FontSize="14" FontWeight="Bold"
                            Foreground="#AAFFFFFF"
                            Background="#5594A3B8"
                            IsEnabled="False"
                            BorderThickness="0"
                            Click="SendBtn_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="15" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
