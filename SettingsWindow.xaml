<ui:FluentWindow x:Class="AiSecretary.Desktop.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AI 秘書 偏好設定"
                 Width="800"
                 Height="640"
                 MinWidth="680"
                 MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Microsoft JhengHei UI, Segoe UI"
                 FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,12,0,8" />
            </Style>

            <Style x:Key="CardGap" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Opacity" Value="0.85" />
            </Style>

            <!-- Windows 11 Settings Left Navigation Item Style -->
            <Style x:Key="Win11NavItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="NavBd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ActivePill"
                                            Grid.Column="0"
                                            Width="3"
                                            Height="16"
                                            CornerRadius="1.5"
                                            Margin="-6,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavBd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="NavBd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="ActivePill" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="SettingsTitleBar"
                     Grid.Row="0"
                     Title="AI 秘書 偏好設定"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Pane (Windows 11 Settings style) -->
            <Border Grid.Column="0"
                    Margin="12,4,0,14"
                    Padding="4,4,8,4"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox x:Name="NavList"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource Win11NavItemStyle}"
                         SelectedIndex="0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Tag="general">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="一般" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="paths">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="信任路徑" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="llm">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BrainCircuit24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="LLM" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="skills">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Skills" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Right Content Pane -->
            <Grid Grid.Column="1" Margin="18,4,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PageHeaderTitle"
                           Grid.Row="0"
                           Text="一般"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="2,0,0,10" />

                <!-- Page 1: 一般 -->
                <ScrollViewer x:Name="PageGeneral" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock x:Name="ThemeGroupTitle" Text="介面與外觀" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />

                        <ui:CardControl Style="{StaticResource CardGap}" Icon="{ui:SymbolIcon WeatherMoon24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock x:Name="ThemeLabel" Text="主題模式" />
                                    <TextBlock Text="深淺色與 Windows 系統同步" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="ThemeCombo" Width="190" SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="跟隨系統" Tag="System" />
                                <ComboBoxItem Content="淺色 (Light)" Tag="Light" />
                                <ComboBoxItem Content="深色 (Dark)" Tag="Dark" />
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource CardGap}" Icon="{ui:SymbolIcon Chat24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock x:Name="FadeLabel" Text="氣泡淡出秒數" />
                                    <TextBlock x:Name="FadeHintText" Text="0 = 不自動淡出" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:NumberBox x:Name="FadeSecondsBox"
                                          Width="130"
                                          Minimum="0"
                                          Maximum="3600"
                                          SmallChange="1"
                                          LargeChange="5"
                                          MaxDecimalPlaces="0" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource CardGap}" Icon="{ui:SymbolIcon Image24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock x:Name="AnimFpsLabel" Text="桌寵動畫幀率" />
                                    <TextBlock Text="降低幀率可節省 CPU / GPU" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="AnimFpsCombo" Width="210" SelectionChanged="AnimFpsCombo_SelectionChanged">
                                <ComboBoxItem Content="關閉動畫 (0 FPS，省電)" Tag="0" />
                                <ComboBoxItem Content="15 FPS (低耗能)" Tag="15" />
                                <ComboBoxItem Content="24 FPS (電影流暢)" Tag="24" />
                                <ComboBoxItem Content="30 FPS (標準)" Tag="30" />
                                <ComboBoxItem Content="60 FPS (極致流暢)" Tag="60" />
                            </ComboBox>
                        </ui:CardControl>

                        <TextBlock Text="行為" Style="{StaticResource SectionTitle}" />

                        <ui:CardControl Style="{StaticResource CardGap}" Icon="{ui:SymbolIcon Play24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="開機自動啟動" />
                                    <TextBlock Text="Windows 登入後自動啟動 AI 秘書" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="RunAtStartupCheck"
                                             Checked="RunAtStartupCheck_Changed"
                                             Unchecked="RunAtStartupCheck_Changed" />
                        </ui:CardControl>

                        <ui:CardExpander Margin="0,0,0,6" Icon="{ui:SymbolIcon Chat24}" IsExpanded="True">
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="閒置主動搭話" />
                                        <TextBlock Text="閒置一段時間後隨機找你聊天" FontSize="12" Opacity="0.65" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="ProactiveChatCheck"
                                                     Grid.Column="1"
                                                     Margin="0,0,8,0"
                                                     Checked="ProactiveChatSetting_Changed"
                                                     Unchecked="ProactiveChatSetting_Changed" />
                                </Grid>
                            </ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="隨機間隔" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" />
                                <ui:NumberBox x:Name="ProactiveMinBox" Width="135" Minimum="1" Maximum="1440" SmallChange="1" MaxDecimalPlaces="0" />
                                <TextBlock x:Name="ProactiveSepText" Text="～" Style="{StaticResource FieldLabel}" Margin="10,0" />
                                <ui:NumberBox x:Name="ProactiveMaxBox" Width="135" Minimum="1" Maximum="1440" SmallChange="1" MaxDecimalPlaces="0" />
                                <TextBlock x:Name="ProactiveUnitText" Text="分鐘" Style="{StaticResource FieldLabel}" Margin="10,0,0,0" />
                            </StackPanel>
                        </ui:CardExpander>

                        <TextBlock Text="秘書造型" Style="{StaticResource SectionTitle}" />

                        <ui:CardControl Style="{StaticResource CardGap}" Icon="{ui:SymbolIcon Person24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="桌寵圖片" />
                                    <TextBlock Text="自訂或還原預設的桌寵造型" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="ChangeImgBtn" Content="更換圖片…" Margin="0,0,8,0" Click="ChangeImgBtn_Click" />
                                <ui:Button x:Name="ResetImgBtn" Content="還原預設" Click="ResetImgBtn_Click" />
                            </StackPanel>
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page 2: 信任路徑 -->
                <Grid x:Name="PageTrustedPaths" Grid.Row="1" Margin="0,0,4,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="沙盒位置" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />

                    <ui:CardControl Grid.Row="1" Margin="0,0,0,6" Icon="{ui:SymbolIcon Folder24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock x:Name="SandboxLabel" Text="預設可寫入工作區" />
                                <TextBlock Text="AI 產生的檔案預設都放在這裡" FontSize="12" Opacity="0.65" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox x:Name="SandboxPathBox" Width="220" IsReadOnly="True" Margin="0,0,8,0" />
                            <ui:Button x:Name="OpenSandboxBtn" Content="開啟資料夾" Click="OpenSandboxBtn_Click" />
                        </StackPanel>
                    </ui:CardControl>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="信任的路徑（可讀寫，含所有子資料夾）" Style="{StaticResource SectionTitle}" Margin="2,4,0,8" />
                        <ui:ListView x:Name="TrustedPathsList"
                                     Grid.Row="1"
                                     SelectionMode="Single"
                                     SelectionChanged="TrustedPathsList_SelectionChanged"
                                     MouseDoubleClick="TrustedPathsList_MouseDoubleClick" />
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <ui:Button x:Name="AddTrustedPathBtn" Content="新增" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="0,0,8,0" Click="AddTrustedPathBtn_Click" />
                        <ui:Button x:Name="EditTrustedPathBtn" Content="編輯" Icon="{ui:SymbolIcon Edit24}" Margin="0,0,8,0" IsEnabled="False" Click="EditTrustedPathBtn_Click" />
                        <ui:Button x:Name="DeleteTrustedPathBtn" Content="刪除" Icon="{ui:SymbolIcon Delete24}" IsEnabled="False" Click="DeleteTrustedPathBtn_Click" />
                    </StackPanel>
                </Grid>

                <!-- Page 3: LLM -->
                <ScrollViewer x:Name="PageLlm" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,8,8">
                        <ui:InfoBar x:Name="LlmHintBar"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="模型來源"
                                    Message="支援 OpenAI / Azure Foundry / Anthropic / Google Gemini API。留空則沿用 .env 預設設定；主 Agent 會依任務複雜度自由指派模型。"
                                    Margin="0,0,0,10" />

                        <ui:CardExpander x:Name="SimpleLlmCard" Margin="0,0,0,6" IsExpanded="True" Icon="{ui:SymbolIcon Flash24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock x:Name="SimpleLlmTitle" Text="簡單任務模型" />
                                    <TextBlock Text="快速路由、一般查詢" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="SimpleEpLbl" Grid.Row="0" Grid.Column="0" Text="Endpoint" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                <ui:TextBox x:Name="SimpleEpBox" Grid.Row="0" Grid.Column="1" PlaceholderText="https://api.openai.com/v1" Margin="0,0,0,8" />

                                <TextBlock x:Name="SimpleKeyLbl" Grid.Row="1" Grid.Column="0" Text="API Key" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                <ui:PasswordBox x:Name="SimpleKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

                                <TextBlock x:Name="SimpleModelLbl" Grid.Row="2" Grid.Column="0" Text="Model" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox x:Name="SimpleModelBox" Grid.Row="2" Grid.Column="1" PlaceholderText="gpt-4o-mini" />
                            </Grid>
                        </ui:CardExpander>

                        <ui:CardExpander x:Name="ComplexLlmCard" Margin="0,0,0,6" IsExpanded="True" Icon="{ui:SymbolIcon BrainCircuit24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock x:Name="ComplexLlmTitle" Text="複雜任務模型" />
                                    <TextBlock Text="多步驟規劃、深度分析" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ComplexEpLbl" Grid.Row="0" Grid.Column="0" Text="Endpoint" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                <ui:TextBox x:Name="ComplexEpBox" Grid.Row="0" Grid.Column="1" PlaceholderText="https://api.openai.com/v1" Margin="0,0,0,8" />

                                <TextBlock x:Name="ComplexKeyLbl" Grid.Row="1" Grid.Column="0" Text="API Key" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                <ui:PasswordBox x:Name="ComplexKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

                                <TextBlock x:Name="ComplexModelLbl" Grid.Row="2" Grid.Column="0" Text="Model" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox x:Name="ComplexModelBox" Grid.Row="2" Grid.Column="1" PlaceholderText="gpt-4o" />
                            </Grid>
                        </ui:CardExpander>

                        <ui:CardControl x:Name="ReplyLangCard" Margin="0,0,0,12" Icon="{ui:SymbolIcon Globe24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock x:Name="ReplyLangLbl" Text="回覆語言" />
                                    <TextBlock Text="例如：繁體中文、zh_tw、English、日本語" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBox x:Name="ReplyLangBox" Width="200" />
                        </ui:CardControl>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="SaveLlmBtn" Content="儲存 LLM 設定" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="SaveLlmBtn_Click" />
                            <TextBlock x:Name="LlmSavedText" Text="已儲存" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#16A34A" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page 4: Skills -->
                <ScrollViewer x:Name="PageSkills" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="SkillsPanel" Margin="0,0,8,8" />
                </ScrollViewer>

                <!-- Footer Actions -->
                <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
                    <ui:Button x:Name="ClearImageHistoryBtn" DockPanel.Dock="Left" Content="清除對話中的附件" Margin="0,0,8,0" Click="ClearImageHistoryBtn_Click" />
                    <ui:Button x:Name="ClearChatHistoryBtn" DockPanel.Dock="Left" Content="清空對話紀錄" Icon="{ui:SymbolIcon Delete24}" Click="ClearChatHistoryBtn_Click" />
                    <ui:Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="關閉" Width="90" Appearance="Primary" Click="CloseBtn_Click" />
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
