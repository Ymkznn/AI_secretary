<Window x:Class="AiSecretary.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 秘書 偏好設定"
        Width="580"
        Height="540"
        MinWidth="540"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Microsoft JhengHei UI, Segoe UI"
        FontSize="12.5">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2.5"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Padding="12" BorderThickness="1">
            <!-- Tab 1: 一般 (介面與造型) -->
            <TabItem x:Name="TabGeneral" Header="一般">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <GroupBox x:Name="ThemeGroupBox" Header="介面與外觀" Padding="10" Margin="0,2,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                    <TextBlock x:Name="ThemeLabel" Text="主題模式：" Width="110" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ThemeCombo" Width="170" SelectionChanged="ThemeCombo_SelectionChanged">
                                        <ComboBoxItem Content="跟隨系統" Tag="System" />
                                        <ComboBoxItem Content="淺色 (Light)" Tag="Light" />
                                        <ComboBoxItem Content="深色 (Dark)" Tag="Dark" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock x:Name="FadeLabel" Text="氣泡淡出秒數：" Width="110" VerticalAlignment="Center" />
                                    <TextBox x:Name="FadeSecondsBox" Width="64" TextChanged="FadeSecondsBox_TextChanged" />
                                    <TextBlock x:Name="FadeHintText" Text=" 秒（0 = 不自動淡出）" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.75" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock x:Name="AnimFpsLabel" Text="桌寵動畫幀率：" Width="110" VerticalAlignment="Center" />
                                    <ComboBox x:Name="AnimFpsCombo" Width="190" SelectionChanged="AnimFpsCombo_SelectionChanged">
                                        <ComboBoxItem Content="關閉動畫 (0 FPS，省電)" Tag="0" />
                                        <ComboBoxItem Content="15 FPS (低耗能)" Tag="15" />
                                        <ComboBoxItem Content="24 FPS (電影流暢)" Tag="24" />
                                        <ComboBoxItem Content="30 FPS (標準)" Tag="30" />
                                        <ComboBoxItem Content="60 FPS (極致流暢)" Tag="60" />
                                    </ComboBox>
                                </StackPanel>

                                <CheckBox x:Name="RunAtStartupCheck"
                                          Content="Windows 開機時自動啟動 AI 秘書"
                                          Margin="0,2,0,10"
                                          Checked="RunAtStartupCheck_Changed"
                                          Unchecked="RunAtStartupCheck_Changed" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <CheckBox x:Name="ProactiveChatCheck"
                                              Content="閒置主動搭話，隨機間隔"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Checked="ProactiveChatSetting_Changed"
                                              Unchecked="ProactiveChatSetting_Changed" />
                                    <TextBox x:Name="ProactiveMinBox" Width="46" TextChanged="ProactiveChatBox_TextChanged" />
                                    <TextBlock x:Name="ProactiveSepText" Text=" ～ " VerticalAlignment="Center" />
                                    <TextBox x:Name="ProactiveMaxBox" Width="46" TextChanged="ProactiveChatBox_TextChanged" />
                                    <TextBlock x:Name="ProactiveUnitText" Text=" 分鐘" VerticalAlignment="Center" Opacity="0.75" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="AppearanceGroupBox" Header="秘書造型" Padding="10">
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                <Button x:Name="ChangeImgBtn" Content="更換圖片…" Margin="0,0,8,0" Click="ChangeImgBtn_Click" />
                                <Button x:Name="ResetImgBtn" Content="還原預設" Click="ResetImgBtn_Click" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 信任路徑 -->
            <TabItem x:Name="TabTrustedPaths" Header="信任路徑">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox x:Name="SandboxGroupBox" Grid.Row="0" Header="沙盒位置" Padding="10" Margin="0,2,0,10">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SandboxLabel" Grid.Column="0" Text="路徑：" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="SandboxPathBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0" />
                            <Button x:Name="OpenSandboxBtn" Grid.Column="2" Content="開啟資料夾" Click="OpenSandboxBtn_Click" />
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="TrustedPathsGroupBox" Grid.Row="1" Header="信任的路徑" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ListView x:Name="TrustedPathsList"
                                      Grid.Row="0"
                                      BorderThickness="1"
                                      SelectionMode="Single"
                                      SelectionChanged="TrustedPathsList_SelectionChanged"
                                      MouseDoubleClick="TrustedPathsList_MouseDoubleClick"
                                      SizeChanged="TrustedPathsList_SizeChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn x:Name="TrustedPathColumn" Header="信任的路徑" Width="460" />
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="AddTrustedPathBtn" Content="新增..." Width="76" Margin="0,0,8,0" Click="AddTrustedPathBtn_Click" />
                                <Button x:Name="EditTrustedPathBtn" Content="編輯..." Width="76" Margin="0,0,8,0" IsEnabled="False" Click="EditTrustedPathBtn_Click" />
                                <Button x:Name="DeleteTrustedPathBtn" Content="刪除" Width="76" IsEnabled="False" Click="DeleteTrustedPathBtn_Click" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Tab 3: LLM -->
            <TabItem x:Name="TabLlm" Header="LLM">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="2">
                        <TextBlock x:Name="LlmHintText"
                                   Text="支援 OpenAI / Azure Foundry / Anthropic / Google Gemini API。留空則沿用 .env 預設設定；主 Agent 會依任務複雜度自由指派模型。"
                                   TextWrapping="Wrap"
                                   Opacity="0.8"
                                   Margin="0,0,0,10" />

                        <Border x:Name="SimpleLlmCard" CornerRadius="8" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="SimpleLlmTitle" Text="簡單任務模型（快速路由、一般查詢）" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="SimpleEpLbl" Grid.Row="0" Grid.Column="0" Text="Endpoint：" VerticalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBox x:Name="SimpleEpBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" />

                                    <TextBlock x:Name="SimpleKeyLbl" Grid.Row="1" Grid.Column="0" Text="API Key：" VerticalAlignment="Center" Margin="0,0,0,6" />
                                    <PasswordBox x:Name="SimpleKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />

                                    <TextBlock x:Name="SimpleModelLbl" Grid.Row="2" Grid.Column="0" Text="Model：" VerticalAlignment="Center" />
                                    <TextBox x:Name="SimpleModelBox" Grid.Row="2" Grid.Column="1" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ComplexLlmCard" CornerRadius="8" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="ComplexLlmTitle" Text="複雜任務模型（多步驟規劃、深度分析）" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="ComplexEpLbl" Grid.Row="0" Grid.Column="0" Text="Endpoint：" VerticalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBox x:Name="ComplexEpBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" />

                                    <TextBlock x:Name="ComplexKeyLbl" Grid.Row="1" Grid.Column="0" Text="API Key：" VerticalAlignment="Center" Margin="0,0,0,6" />
                                    <PasswordBox x:Name="ComplexKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />

                                    <TextBlock x:Name="ComplexModelLbl" Grid.Row="2" Grid.Column="0" Text="Model：" VerticalAlignment="Center" />
                                    <TextBox x:Name="ComplexModelBox" Grid.Row="2" Grid.Column="1" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ReplyLangCard" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReplyLangLbl" Grid.Column="0" Text="回覆語言：" VerticalAlignment="Center" />
                                <TextBox x:Name="ReplyLangBox" Grid.Column="1" ToolTip="自由輸入 LLM 回覆語言，例如：繁體中文、zh_tw、English、日本語" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveLlmBtn" Content="儲存 LLM 設定" Click="SaveLlmBtn_Click" />
                            <TextBlock x:Name="LlmSavedText" Text="已儲存" Visibility="Collapsed" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#16A34A" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: Skills -->
            <TabItem x:Name="TabSkills" Header="Skills">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="2">
                    <StackPanel x:Name="SkillsPanel" />
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="ClearImageHistoryBtn" DockPanel.Dock="Left" Content="清除對話中的附件" Margin="0,0,8,0" Click="ClearImageHistoryBtn_Click" />
            <Button x:Name="ClearChatHistoryBtn" DockPanel.Dock="Left" Content="清空對話紀錄" Click="ClearChatHistoryBtn_Click" />
            <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="關閉" Width="80" Click="CloseBtn_Click" />
        </DockPanel>
    </Grid>
</Window>
